# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Virtual env
.venv/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Environment / secrets
.env

# Local tool config - machine-specific, not part of the project
.claude/
CLAUDE.md
CLAUDE.local.md

# Machine-specific runtime config (copy pharos.toml.example -> pharos.toml locally)
pharos.toml

# Working log of a desktop validation run; DESKTOP_VALIDATION.md is the durable doc
VALIDATION_FINDINGS.md

# Session notes on where the work stands; the README and the commits are the durable record
HANDOFF.md

# Per-machine calibration data written by the proxy (token counts only, never text)
pharos_observations.json

# Model weights (e.g. a GGUF pulled for offline tokenizer tests) — never commit these
*.gguf

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Runtime logs (rotating file written by the TUI/proxy)
*.log

# Pharos configuration — copy this file to `pharos.toml` and edit for your machine.
# Moving laptop -> desktop should be a change HERE, never in source. `pharos.toml` itself is
# gitignored so machine-specific values (absolute paths, LAN addresses) never enter the repo.

# Upstream LLM backend (Ollama). A local instance, or the desktop's LAN address.
backend_url = "http://localhost:11434"

# Active model. Optional: if omitted, Pharos auto-detects the loaded model from /api/ps.
# model = "qwen3.5-9b-heretic"

# Exact path to the model's GGUF, used for CPU-only (vocab_only) exact token counting.
# Optional: if omitted, Pharos tries to auto-resolve it from Ollama's blob store. Setting it
# explicitly is the robust option and avoids depending on Ollama's storage layout.
# gguf_path = "C:/Users/you/.ollama/models/blobs/sha256-abc123..."

# Tokens reserved for the model's response when computing the usable input budget.
response_reserve = 1024

# Tokens `pharos split` holds back in every scope part for the previous part's hand-off, which
# you paste above the next part. Measured across real agent runs (qwen3.5-9b), hand-offs to the
# same "at most 10 lines" instruction ranged from 64 to 328 tokens — a model's idea of ten lines
# is not a constant. Raise it if your agent writes long hand-offs.
handoff_reserve = 500

# Carry Pharos's own record of what has landed on disk from part to part, alongside the
# hand-off the model writes. On by default: across sixteen live runs the model's half proved
# unreliable in one specific way — parts changed files and then reported "NO CHANGES NEEDED" —
# and the record is written by the dispatcher as each write succeeds, so it cannot be wrong.
# It shares handoff_reserve with the prose rather than adding to it, taking at most half.
# Set it to false to see what the model's own hand-offs achieve alone.
handoff_ledger = true

# The window `pharos run` asks the backend to load the model with. Ollama picks a cautious
# VRAM-based default (4,096 on a 12 GB card), and that is too small for agentic work: the part
# scaffold alone fills it before a single file can be scoped in. Leave it commented out and
# whatever is already loaded is used and measured as-is — Pharos never quietly changes a window
# it is also reporting on. Uncomment it and `pharos run` loads the model at that size and says
# so. `pharos check` will tell you what the card can actually hold.
# num_ctx = 16384

# Context-usage thresholds (as a fraction of the usable budget) for TUI warnings.
warn_threshold = 0.80
alert_threshold = 0.90

# KV-cache VRAM estimate: MiB per 1K context tokens — a FALLBACK, used only when the model
# publishes too little to compute the real figure.
#
# Normally Pharos derives this from the model's own GGUF metadata (block_count, kv head count
# and head dimensions, all returned by /api/show) and the report says "derived". It falls back
# to the value here, labelled "configured", for models that omit those keys or that use
# sliding-window attention, where the layer pattern is not published and deriving would
# overstate KV several-fold.
#
# Leave it alone unless your report says "configured". If it does, measure rather than guess:
# load the model at two num_ctx values and take the size_vram delta from /api/ps.
#
#   curl -s localhost:11434/api/chat -d '{"model":"M","messages":[{"role":"user","content":"hi"}],"options":{"num_ctx":32768},"stream":false}' >/dev/null
#   curl -s localhost:11434/api/ps            # note size_vram
#   ... repeat with num_ctx 65536, note size_vram again ...
#   kv_mib_per_1k = (vram2 - vram1) / 1048576 / ((ctx2 - ctx1) / 1000)
#
# Measure from 8K upward and use three windows, not two: below ~8K a fixed allocation is still
# changing and the line bends. A 4K/8K pair read 59% high on qwen2.5-coder:7b.
#
# Measured on an RTX 3060 (MiB/1K): qwen2.5-coder:7b 56.6, qwen3-4b 142.6, qwen3.5-9b 32.2 —
# a 4x spread across three models, which is why a single constant was never going to hold.
kv_mib_per_1k = 32

# Free VRAM held back before estimating headroom (and the num_ctx ceiling the mismatch banner
# suggests). Drivers, fragmentation and display compositing claim VRAM without warning; advice
# that spends the last free byte is an OOM invitation.
vram_safety_margin_mib = 512

# Where Pharos itself listens. Point your coding agent at this address (not directly at Ollama).
proxy_host = "127.0.0.1"
proxy_port = 11435

# The TUI owns the terminal, so request/error detail goes to a rotating log file instead.
log_file = "pharos.log"

# Root that `pharos check` resolves file references against (the repo you point your coding
# agent at). Unset: the current directory is used, with a warning.
# target_folder = "."

# --- verification (v0.4.2) ----------------------------------------------------------------------

# After a run, re-run the checks this project already has and report what the run broke. The
# exit code follows it: a run that wrote every file and stopped the project building exits 1.
#
# Mechanical only -- exit codes from your own tools, never a model's opinion of the code. Every
# check ALSO runs before the first part, so a suite that was already failing is reported as
# such and never charged to the run.
verify = true

# End the run at the first part that leaves a file it wrote unparseable, instead of carrying
# on into the parts after it. Off by default, and that is a judgement rather than a
# measurement: a broken file is sometimes fixed by a later part or by the repair sweep, and
# every coverage figure published for this project was measured on runs that ran to the end.
# What argues for turning it on is also measured -- from v0.6 the record between parts carries
# a broken part's conventions to every part after it, so damage propagates.
stop_on_break = false

# A project check is also run after EVERY part when the baseline measured it taking no longer
# than this, so a part that breaks the linter is named the same way a part that breaks the
# parser is. Measured rather than configured: the baseline has already run every check, so it
# knows what each costs here. A part takes 30-60s on the reference machine, so a check at this
# ceiling adds under 10% per part. Set it to 0 to check only that files still parse.
per_part_check_seconds = 3.0

# Where `pharos run` remembers how many TOKENS the backend's own count runs above its
# projection, per model -- the cost of a chat template that is applied server-side and cannot
# be seen from here. Measured flat at 263-314 tokens over a 3x range of conversation sizes,
# which is why it is a token count and not a ratio. Seeding a part with it means the part's FIRST request is corrected too,
# which before v0.9 was the one request per part that nothing but the safety margin covered.
# Counts only, gitignored, and safe to delete: the next run measures it again.
# template_memory_file = "pharos_templates.json"

# The checks to run. Left unset, Pharos detects the ones this repository configures AND that
# are installed (ruff, pytest) -- it never invents a build command for a project that did not
# ask for one. Set this and the list is used verbatim, which is how any other ecosystem is
# checked:
#
#   verify_commands = ["dotnet build --nologo"]
#   verify_commands = ["npm test", "npx tsc --noEmit"]
#   verify_commands = ["ruff check .", "mypy src", "pytest -q"]
#
# A tool that is not on PATH is reported as skipped, never as passing.
# verify_commands = []

# Per-command ceiling, in seconds. A check that outruns it is reported as skipped rather than
# passed: a run must not be able to turn a slow suite green by outwaiting it. Note that checks
# run twice (once for the baseline), so a slow suite costs double -- `pharos run --no-verify`
# skips both.
verify_timeout_seconds = 300

# --- pre-flight calibration (v0.2 "Warn") -------------------------------------------------------

# Tokens your coding agent adds on top of a pasted prompt: system prompt, tool catalogue,
# injected context. Normally learned automatically from traffic observed through the proxy;
# set this to pin it manually (it then takes precedence over the learned value).
# client_overhead_tokens = 10000

# Tokens the agent pulls in ON ITS OWN over one task -- the files it opens that nobody
# named. `pharos check` prints this as EXPECTED, between the FLOOR and the CEILING, and it
# is normally learned from whole agent conversations seen by the proxy (three or more, or
# it says it does not know rather than guessing). Set this to pin it.
# agent_read_tokens = 8000

# Where the proxy records per-request token counts for that calibration. Counts only — no
# prompt text, file names or any reconstructable content is ever written.
observations_file = "pharos_observations.json"

# --- Semantic grouping (pharos split --semantic / pharos run --semantic) -----------------
# Off unless you pass the flag. With it, the backend is asked which files belong in a part
# together; the proposal is then checked in code (coverage, the file cap, the part ceiling,
# and whether every group still fits) and discarded for position packing if it fails any of
# them. This is the only Pharos command that sends anything anywhere: with --semantic it
# sends the task, the filenames, their token counts and the first five lines of each file.

# Which model answers the grouping question. Unset, it is the model doing the work. Worth
# setting: grouping is a small structured job and the best model for it is not the best model
# for writing code — measured, the ranking between them reverses depending on whether the
# file excerpts are sent. See DESKTOP_VALIDATION.md section 18.
# semantic_model = "qwen2.5-coder:7b"

# How many parts beyond the mechanical count a semantic grouping may spend to keep related
# files together. Grouping by meaning packs worse than first-fit almost by definition, so some
# slack has to be allowed; unbounded slack lets a model "group" one file per part and buy a
# hand-off for each one. A stated preference, not a measurement.
# semantic_max_extra_parts = 2

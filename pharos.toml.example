# Pharos configuration — copy this file to `pharos.toml` and edit for your machine.
# Moving laptop -> desktop should be a change HERE, never in source. `pharos.toml` itself is
# gitignored so machine-specific values (absolute paths, LAN addresses) never enter the repo.

# Upstream LLM backend (Ollama). A local instance, or the desktop's LAN address.
backend_url = "http://localhost:11434"

# Active model. Optional: if omitted, Pharos auto-detects the loaded model from /api/ps.
# model = "qwen3.5-9b-heretic"

# Exact path to the model's GGUF, used for CPU-only (vocab_only) exact token counting.
# Optional: if omitted, Pharos tries to auto-resolve it from Ollama's blob store. Setting it
# explicitly is the robust option and avoids depending on Ollama's storage layout.
# gguf_path = "C:/Users/you/.ollama/models/blobs/sha256-abc123..."

# Tokens reserved for the model's response when computing the usable input budget.
response_reserve = 1024

# Context-usage thresholds (as a fraction of the usable budget) for TUI warnings.
warn_threshold = 0.80
alert_threshold = 0.90

# KV-cache VRAM estimate: MiB per 1K context tokens. This is an ESTIMATE only (it varies with
# architecture, flash-attention and KV-cache quantization); the TUI labels it as such and
# always trusts measured free VRAM over this number.
#
# 32 is a deliberately conservative default, NOT a universal constant — the right value is
# model-specific. To measure it for your model: load it at two different num_ctx values and
# take the size_vram delta reported by /api/ps, then divide by the context delta.
#
#   curl -s localhost:11434/api/chat -d '{"model":"M","messages":[{"role":"user","content":"hi"}],"options":{"num_ctx":32768},"stream":false}' >/dev/null
#   curl -s localhost:11434/api/ps            # note size_vram
#   ... repeat with num_ctx 65536, note size_vram again ...
#   kv_mib_per_1k = (vram2 - vram1) / 1048576 / ((ctx2 - ctx1) / 1000)
#
# Measured examples: qwen3.5-9b-heretic (9B, Q8_0) ≈ 26.
kv_mib_per_1k = 32

# Free VRAM held back before estimating headroom (and the num_ctx ceiling the mismatch banner
# suggests). Drivers, fragmentation and display compositing claim VRAM without warning; advice
# that spends the last free byte is an OOM invitation.
vram_safety_margin_mib = 512

# Where Pharos itself listens. Point your coding agent at this address (not directly at Ollama).
proxy_host = "127.0.0.1"
proxy_port = 11435

# The TUI owns the terminal, so request/error detail goes to a rotating log file instead.
log_file = "pharos.log"

# Root that `pharos check` resolves file references against (the repo you point your coding
# agent at). Unset: the current directory is used, with a warning.
# target_folder = "."

# --- pre-flight calibration (v0.2 "Warn") -------------------------------------------------------

# Tokens your coding agent adds on top of a pasted prompt: system prompt, tool catalogue,
# injected context. Normally learned automatically from traffic observed through the proxy;
# set this to pin it manually (it then takes precedence over the learned value).
# client_overhead_tokens = 10000

# Where the proxy records per-request token counts for that calibration. Counts only — no
# prompt text, file names or any reconstructable content is ever written.
observations_file = "pharos_observations.json"
